// 2 bits per cell: sub-cell land coverage 0, 1/3, 2/3, 1

float landCovRaw(int ix, int iy) {
  int idx = iy * LAND_W + ix;
  uint w = uint(0);
  uint sh = uint(0);
  w = EARTH_LAND[(idx >> 4)];
  sh = uint((idx & 15) * 2);
  return 0.33333334F * float((w >> sh & uint(3)));
}

// 4 bits per cell: gaussian blurred land coverage (continental shelf)

float coastRaw(int ix, int iy) {
  int idx = iy * SMALL_W + ix;
  uint v = uint(0);
  uint sh = uint(0);
  v = EARTH_COAST[(idx >> 3)];
  sh = uint((idx & 7) * 4);
  return float((v >> sh & uint(15))) / 15.F;
}

// RGB565, two cells per word

vec3 albRaw(int ix, int iy) {
  int idx = iy * SMALL_W + ix;
  uint w = uint(0);
  uint v = uint(0);
  w = EARTH_ALB[(idx >> 1)];
  v = (w >> uint((idx & 1) * 16) & uint(65535));
  return vec3(float((v >> uint(11) & uint(31))) / 31.F,
              float((v >> uint(5) & uint(63))) / 63.F,
              float((v & uint(31))) / 31.F);
}

// 4 bits per cell: night time light emission

float litRaw(int ix, int iy) {
  int idx = iy * SMALL_W + ix;
  uint v = uint(0);
  uint sh = uint(0);
  v = EARTH_LIT[(idx >> 3)];
  sh = uint((idx & 7) * 4);
  return float((v >> sh & uint(15))) / 15.F;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  ivec2 ipx = ivec2(fragCoord);
  vec4 outv = vec4(0.F);
  int ly = 0;
  int sy = 0;
  int sx = 0;
  ly = (ipx.y - LAND_Y);
  sy = (ipx.y - SMALL_Y);
  // --- camera choreography ---
  if (ipx == ivec2(0, 0)) {
    outv = tourQuat(iTime);
  }
  if (ipx == ivec2(1, 0)) {
    outv = tourAux(iTime);
  }
  // --- land coverage block ---
  if (ly >= 0 && ly < LAND_H && ipx.x < LAND_W) {
    outv = vec4(landCovRaw(ipx.x, ly));
  }
  // --- coast / albedo / night light blocks ---
  if (sy >= 0 && sy < SMALL_H) {
    sx = (ipx.x - COAST_X);
    if (sx >= 0 && sx < SMALL_W) {
      outv = vec4(coastRaw(sx, sy));
    }
    sx = (ipx.x - ALB_X);
    if (sx >= 0 && sx < SMALL_W) {
      outv = vec4(albRaw(sx, sy), 1.0F);
    }
    sx = (ipx.x - LIT_X);
    if (sx >= 0 && sx < SMALL_W) {
      outv = vec4(litRaw(sx, sy));
    }
  }
  fragColor = outv;
}
